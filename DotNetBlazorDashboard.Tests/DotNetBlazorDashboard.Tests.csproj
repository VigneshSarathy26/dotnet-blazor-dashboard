<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- Unit Testing: xUnit & NUnit -->
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- End-to-End Testing: Playwright -->
    <PackageReference Include="Microsoft.Playwright" Version="1.50.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotNetBlazorDashboard.Web\DotNetBlazorDashboard.Web.csproj" />
    <ProjectReference Include="..\DotNetBlazorDashboard.Application\DotNetBlazorDashboard.Application.csproj" />
    <ProjectReference Include="..\DotNetBlazorDashboard.Infrastructure\DotNetBlazorDashboard.Infrastructure.csproj" />
    <ProjectReference Include="..\DotNetBlazorDashboard.Domain\DotNetBlazorDashboard.Domain.csproj" />
  </ItemGroup>

</Project>